# ---------------------------------------------------------------------------
# Host ports. Every port the stack exposes is defined here and nowhere else,
# so if one collides with something you already run, change it here only.
# These are deliberately off the defaults (5432 / 9092 / 8081 ...) so the lab
# can run next to an existing Postgres or Kafka.
# ---------------------------------------------------------------------------
POSTGRES_PORT=25432
KAFKA_PORT=39092
SCHEMA_REGISTRY_PORT=28081
CONNECT_PORT=28083
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
ICEBERG_REST_PORT=28181
TRINO_PORT=28080
KAFKA_UI_PORT=28090

# ---------------------------------------------------------------------------
# Wire format for the CDC topics. Set once here; the Connect worker reads it and
# both connectors inherit it.
#
#   json without schemas  (default) The message on the wire is just the row --
#         readable with any console consumer, no "schema" block, no extra
#         service. Types are not lost because the Iceberg tables are created
#         from explicit DDL (trino/tables.sql) instead of being inferred.
#
#   json with schemas     Same JSON, but every message also carries a "schema"
#         block larger than the row itself. Set CDC_JSON_SCHEMAS_ENABLED=true.
#
#   avro  Compact binary on the wire, schema registered once in Schema Registry.
#         What you would run at volume. `make up` starts Schema Registry for you.
# ---------------------------------------------------------------------------
CDC_CONVERTER=org.apache.kafka.connect.json.JsonConverter
#CDC_CONVERTER=io.confluent.connect.avro.AvroConverter

# Only applies to the JSON converter above.
CDC_JSON_SCHEMAS_ENABLED=false

# Source database
POSTGRES_DB=shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=debezium

# Object storage / Iceberg warehouse
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
ICEBERG_WAREHOUSE=s3://warehouse/
